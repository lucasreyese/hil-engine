VERSION "hil-engine 0.1"


NS_ :
	NS_DESC_
	CM_
	BA_DEF_
	BA_
	VAL_
	CAT_DEF_
	CAT_
	FILTER
	BA_DEF_DEF_
	EV_DATA_
	ENVVAR_DATA_
	SGTYPE_
	SGTYPE_VAL_
	BA_DEF_SGTYPE_
	BA_SGTYPE_
	SIG_TYPE_REF_
	VAL_TABLE_
	SIG_GROUP_
	SIG_VALTYPE_
	SIGTYPE_VALTYPE_
	BO_TX_BU_
	BA_DEF_REL_
	BA_REL_
	BA_DEF_DEF_REL_
	BU_SG_REL_
	BU_EV_REL_
	BU_BO_REL_
	SG_MUL_VAL_

BS_:

BU_: ENGINE_SIM ECM


BO_ 256 ENG_SPEED: 6 ENGINE_SIM
 SG_ EngSpeedFiltered : 0|16@1+ (0.25,0) [0|16383.75] "rpm" ECM
 SG_ EngSpeedInstant : 16|16@1+ (0.25,0) [0|16383.75] "rpm" ECM
 SG_ CrankAngle : 32|16@1+ (0.02,0) [0|720] "deg" ECM

BO_ 272 ENG_AIR: 6 ENGINE_SIM
 SG_ MassAirFlow : 0|16@1+ (0.01,0) [0|655.35] "g/s" ECM
 SG_ ThrottlePosition : 16|16@1+ (0.01,0) [0|100] "%" ECM
 SG_ IntakeAirTemp : 32|16@1- (0.1,0) [-40|150] "degC" ECM

BO_ 288 ENG_THERMAL: 2 ENGINE_SIM
 SG_ CoolantTemp : 0|16@1- (0.1,0) [-40|150] "degC" ECM

BO_ 304 ENG_COMBUSTION: 4 ENGINE_SIM
 SG_ Lambda : 0|16@1+ (0.001,0) [0|2] "lambda" ECM
 SG_ KnockIntensity : 16|16@1+ (0.0001,0) [0|1] "ratio" ECM

BO_ 512 ECM_ACTUATORS: 8 ECM
 SG_ IgnitionAdvance : 0|16@1- (0.1,0) [-30|50] "degBTDC" ENGINE_SIM
 SG_ InjectorPulseWidth : 16|16@1+ (0.001,0) [0|65.535] "ms" ENGINE_SIM
 SG_ FuelTrim : 32|16@1- (0.01,0) [-25|25] "%" ENGINE_SIM
 SG_ ColdStartEnrich : 48|8@1+ (0.5,0) [0|100] "%" ENGINE_SIM
 SG_ IdleTargetRpm : 56|8@1+ (10,0) [0|2550] "rpm" ENGINE_SIM

BO_ 528 ECM_STATUS: 6 ECM
 SG_ EcmState : 0|8@1+ (1,0) [0|4] "" ENGINE_SIM
 SG_ StatusFlags : 8|8@1+ (1,0) [0|255] "" ENGINE_SIM
 SG_ KnockRetard : 16|16@1- (0.1,0) [0|25] "deg" ENGINE_SIM
 SG_ TargetLambda : 32|16@1+ (0.001,0) [0|2] "lambda" ENGINE_SIM



CM_ BO_ 256 "Crank speed and position. Sent every 10 ms.";
CM_ SG_ 256 EngSpeedInstant "Instantaneous speed including torsional ripple; aliased above idle, use for low-speed/idle diagnostics.";
CM_ SG_ 256 CrankAngle "Engine cycle position 0-720 deg. Aliased on a 10 ms frame above idle; diagnostic only.";
CM_ BO_ 272 "Air path sensors. Sent every 20 ms.";
CM_ BO_ 288 "Slow thermal channel. Sent every 100 ms.";
CM_ BO_ 304 "Combustion-quality sensors (wideband O2 + knock). Sent every 10 ms.";
CM_ BO_ 512 "Actuator commands from the ECM. InjectorPulseWidth is the only physical fueling actuator; FuelTrim and ColdStartEnrich are ECM telemetry already folded into the pulse width. Sent every 10 ms.";
CM_ BO_ 528 "ECM internal state for HIL observability. Sent every 100 ms.";

VAL_ 528 EcmState 0 "INIT" 1 "CRANKING" 2 "WARMUP" 3 "RUNNING" 4 "STALL" ;
